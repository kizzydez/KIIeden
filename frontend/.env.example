# --- Filled in AUTOMATICALLY by `npm run deploy:testnet` in ../contracts -------------
# (contracts/scripts/deploy.js writes these into frontend/.env.local for you.)
# Which KiiChain the app talks to: 1336 = Testnet Oro, 1783 = Mainnet
NEXT_PUBLIC_CHAIN_ID=1336
NEXT_PUBLIC_FEE_MANAGER_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_RWA_FACTORY_ADDRESS=
NEXT_PUBLIC_RWA_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_RWA_CURVE_ADDRESS=
NEXT_PUBLIC_RWA_CHAT_ADDRESS=
# Block the contracts were deployed at. Event scans start here, which keeps the
# app fast and stops the RPC from rejecting huge log ranges.
NEXT_PUBLIC_DEPLOY_BLOCK=

# --- You fill these in -----------------------------------------------------------
# WalletConnect Cloud project ID (free): https://cloud.walletconnect.com
# MetaMask / browser wallets work without it; mobile wallets via QR need it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints (defaults are the public KiiChain endpoints)
NEXT_PUBLIC_KII_TESTNET_RPC=https://json-rpc.uno.sentry.testnet.v3.kiivalidator.com
# Verify against KiiChain's official docs before going live on mainnet.
NEXT_PUBLIC_KII_MAINNET_RPC=https://evmrpc.kiichain.nodestake.org

# Primary IPFS gateway used to display images/metadata (fallbacks are built in)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# --- Business details (REQUIRED before launch: shown in the footer and on every legal page) ---
# Use the real legal entity that operates this site. `npm run check:compliance` fails until these are set.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_TRADING_NAME=KiiEden
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_REG_NUMBER=
# Country whose law governs the Terms, e.g. "England and Wales"
NEXT_PUBLIC_BUSINESS_JURISDICTION=
NEXT_PUBLIC_BUSINESS_EMAIL=
# Optional: a separate privacy contact and a VAT number
NEXT_PUBLIC_BUSINESS_PRIVACY_EMAIL=
NEXT_PUBLIC_BUSINESS_VAT=

# --- Site + security -----------------------------------------------------------
# Full public URL of this deployment, used in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Content-Security-Policy mode set by middleware.ts:
#   report-only (default) - CSP violations are only logged in the browser console, nothing is blocked
#   enforce                - CSP is enforced (blocks violations)
#   off                    - no CSP header at all (not recommended)
# Deploy with report-only first, check the browser console on every page, THEN switch to enforce.
CSP_MODE=report-only
