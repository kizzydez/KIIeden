{
  "name": "kiichain-nft-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:compliance": "node scripts/check-compliance.mjs",
    "build:prod": "node scripts/scan-secrets.mjs && node scripts/check-compliance.mjs && next build",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "check:all": "node scripts/scan-secrets.mjs && node scripts/check-links.mjs && node scripts/check-compliance.mjs && tsc --noEmit"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wagmi": "^2.12.7",
    "viem": "^2.19.6",
    "@tanstack/react-query": "^5.51.23",
    "@rainbow-me/rainbowkit": "^2.1.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.9",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20"
  },
  "engines": {
    "node": ">=20"
  }
}
