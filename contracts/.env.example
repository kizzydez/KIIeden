# --- Deployer ---------------------------------------------------------------
# Private key of a funded wallet. NEVER commit this file.
DEPLOYER_PRIVATE_KEY=

# --- RPC endpoints ----------------------------------------------------------
# Testnet Oro (EVM chain id 1336) - this endpoint is the one already used for the testnet deploy.
KII_TESTNET_RPC=https://json-rpc.uno.sentry.testnet.v3.kiivalidator.com
# Mainnet (EVM chain id 1783). VERIFY this endpoint against KiiChain's official docs before deploying.
KII_MAINNET_RPC=https://evmrpc.kiichain.nodestake.org

# --- Where money goes -------------------------------------------------------
# Receives the protocol-usage fee. Optional on testnet (defaults to the deployer),
# REQUIRED on mainnet (use your multisig).
TREASURY_ADDRESS=
# Receives the marketplace trade fees. Defaults to TREASURY_ADDRESS.
FEE_RECIPIENT_ADDRESS=

# --- Protocol-usage fee (KII) -------------------------------------------------
# Leave blank for the defaults: 2 KII on testnet (1336), 1 KII on mainnet (1783).
# Any value from 0 to 50 is allowed (50 KII is a hard ceiling in the contract).
FEE_KII=

# --- Optional -----------------------------------------------------------------
# Wallet that should control RWA asset listing (RWAFactory owner). Blank = deployer.
RWA_ADMIN_ADDRESS=
# Required to deploy to mainnet: CONFIRM_MAINNET=yes
CONFIRM_MAINNET=
# Set to 0 to stop deploy.js from writing addresses into ../frontend/.env.local
WRITE_FRONTEND_ENV=
